<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Todo reminder -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 闹钟响铃：全屏拉起响铃页 + 震动 -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Network for weather lookup -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Location for diary weather lookup -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <application
        android:name=".DiaryApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="Pocket Diary"
        android:supportsRtl="true"
        android:theme="@style/Theme.PocketDiary">
        
        <activity
            android:name=".MainActivity"
            android:theme="@style/Theme.PocketDiary.Starting.Dark"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 倒数日分享图：cacheDir/share 临时授权给目标应用读取 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <receiver android:name=".receiver.TodoAlarmReceiver" android:exported="false" />

        <!-- 待办闹钟响铃页：锁屏亮屏全屏拉起 -->
        <activity
            android:name=".ui.todo.TodoRingActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:showOnLockScreen="true"
            android:turnScreenOn="true"
            android:taskAffinity=""
            android:theme="@style/Theme.PocketDiary.Ring" />
        <!-- 开机 / 应用更新 / 改系统时间/时区 → 全量重排提醒（僵尸闹钟随旧进程消失） -->
        <receiver android:name=".receiver.BootCompletedReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
