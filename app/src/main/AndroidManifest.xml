<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Network for weather lookup -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Location for diary weather lookup -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <application
        android:name=".DiaryApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="Pocket Diary"
        android:supportsRtl="true"
        android:theme="@style/Theme.PocketDiary">
        <activity
            android:name=".MainActivity"
            android:theme="@style/Theme.PocketDiary.Starting.Dark"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
