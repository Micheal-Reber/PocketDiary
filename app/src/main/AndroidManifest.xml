<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Todo reminder -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 闹钟响铃：全屏拉起响铃页 + 震动 -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- 番茄钟：离开 UI 后仍需计时，故跑一个前台服务 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Android 16 实时活动（状态栏「灵动岛」药丸）：官方硬性要求之一，缺了系统不会提升常驻通知 -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />

    <!-- 倒数日提醒 + 同步到系统日历 -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />

    <!-- Network for weather lookup -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Location for diary weather lookup -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <application
        android:name=".DiaryApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.PocketDiary">
        
        <activity
            android:name=".MainActivity"
            android:theme="@style/Theme.PocketDiary.Starting.Dark"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 倒数日分享图：cacheDir/share 临时授权给目标应用读取 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <receiver android:name=".receiver.TodoAlarmReceiver" android:exported="false" />
        <receiver android:name=".receiver.CountdownAlarmReceiver" android:exported="false" />

        <!-- 番茄钟前台服务：计时真值是持久化快照的差值，服务只负责保活与到点结算 -->
        <service
            android:name=".data.focus.FocusService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Pomodoro timer must keep counting after leaving the app" />
        </service>

        <!-- 专注守卫：只在专注段把离开的用户拉回，只读前台包名（不取窗口内容） -->
        <service
            android:name=".data.focus.FocusGuardService"
            android:exported="false"
            android:label="@string/focus_guard_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/focus_guard_config" />
        </service>

        <!-- 待办闹钟响铃页：锁屏亮屏全屏拉起 -->
        <activity
            android:name=".ui.todo.TodoRingActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:showOnLockScreen="true"
            android:turnScreenOn="true"
            android:taskAffinity=""
            android:theme="@style/Theme.PocketDiary.Ring" />
        <!-- 开机 / 应用更新 / 改系统时间/时区 → 全量重排提醒（僵尸闹钟随旧进程消失） -->
        <receiver android:name=".receiver.BootCompletedReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- 倒数日桌面小组件：2×2 单事件卡片（‹ › 切换 + 系统广播兜底刷新） -->
        <receiver
            android:name=".ui.widget.CountdownWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.USER_PRESENT" />
                <action android:name="com.example.diary.action.CD_WIDGET_MIDNIGHT" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/countdown_widget_info" />
        </receiver>
    </application>
</manifest>
